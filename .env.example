# ─── Backend ────────────────────────────────────────────────────────────────
# Port the Express/Socket.io server listens on.
PORT=3001

# Comma-separated CORS allowlist for the REST API and Socket.io handshake.
# Only these origins may connect. Defaults to the local dev frontend if unset.
ALLOWED_ORIGINS=http://localhost:5200,http://localhost:3000

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend (REST + WebSocket).
# In local dev the Vite proxy handles /api and /socket.io, so this is optional.
VITE_BACKEND_URL=http://localhost:3001
