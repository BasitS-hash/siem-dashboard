{
  "name": "siem-backend",
  "version": "1.0.0",
  "description": "SIEM Dashboard Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc && node dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "socket.io": "4.8.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.39",
    "@types/uuid": "11.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
