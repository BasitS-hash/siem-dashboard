{
  "name": "siem-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-require-module vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "0.312.0",
    "react": "18.3.1",
    "react-dom": "19.2.7",
    "recharts": "2.15.4",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.5.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.3.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
